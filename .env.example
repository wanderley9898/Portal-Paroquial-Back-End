# Environment & Application
NODE_ENV=development # development or production
PORT=3001

# API Key
API_KEY=your-api-key

# Database
DATABASE_HOST=localhost
DATABASE_NAME=dev-database
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-database-password
DATABASE_SCHEMA=portal_paroquial

# JWT
JWT_SECRET=your-jwt-secret
ACCESS_TOKEN_VALIDITY_DURATION_IN_DAYS=3d

# User Admin
SET_USER_EMAIL=admin@example.com
SET_USER_DOCUMENT=000.000.000-00
SET_USER_NAME=Admin
SET_USER_PASSWORD=your-admin-password

# Storage - RustFS / S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=your-service-account-access-key
S3_SECRET_KEY=your-service-account-secret-key
S3_BUCKET=pousada
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000
S3_USE_SSL=false
S3_FOLDER=portal_paroquial